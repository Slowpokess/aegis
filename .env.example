AEGIS_ENVIRONMENT=development
AEGIS_DATABASE_URL=sqlite:///./aegis.db
AEGIS_AUTO_CREATE_SCHEMA=true
AEGIS_LOG_LEVEL=INFO
AEGIS_EXECUTOR_PATH=native/rust/target/debug/aegis-executor
AEGIS_EXECUTOR_PROCESS_GRACE_SECONDS=2.0
AEGIS_POLICY_PATH=native/rust/target/debug/aegis-policy
AEGIS_POLICY_PROCESS_TIMEOUT_SECONDS=3.0
AEGIS_POLICY_MAX_REQUESTS_PER_MINUTE=30
AEGIS_POLICY_MAX_RESPONSE_BYTES=100000
AEGIS_POLICY_MAX_TIMEOUT_MS=10000
AEGIS_MIN_VERIFICATION_RUNS=1
AEGIS_EVAL_TARGET_HOST=127.0.0.1
AEGIS_EVAL_TARGET_PORT=8001
AEGIS_EVAL_TARGET_SCHEME=http
AEGIS_EVAL_REPORT_DIRECTORY=reports/evals
AEGIS_GRAPH_MAX_DEPTH=6
AEGIS_GRAPH_MAX_PATHS=100
AEGIS_GRAPH_MAX_NODES=10000
AEGIS_TOOL_MAX_CONCURRENCY=2
AEGIS_TOOL_MAX_RUNS_PER_PLAN=8
AEGIS_TOOL_ARTIFACT_MAX_BYTES=1000000
AEGIS_NMAP_ENABLED=true
AEGIS_LLM_PROVIDER=fake
AEGIS_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AEGIS_LLM_TIMEOUT_SECONDS=30
AEGIS_LLM_MAX_RETRIES=2
AEGIS_LLM_MAX_OUTPUT_TOKENS=4096
AEGIS_MAX_HYPOTHESES_PER_RUN=5
AEGIS_LLM_CONTEXT_MAX_OBSERVATIONS=50
AEGIS_LLM_CONTEXT_MAX_BODY_CHARACTERS=2000
AEGIS_LLM_CONTEXT_MAX_TOTAL_CHARACTERS=50000
# ANTHROPIC_API_KEY=configure-outside-version-control
# NVIDIA_API_KEY=configure-outside-version-control
AEGIS_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
AEGIS_NVIDIA_REASONING_BUDGET=2048
AEGIS_CONTROLLER_EXPERIMENTAL_MODE=false
